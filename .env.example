# =============================================================================
# saas-tracker — environment variables
# Auth: Vercel Deployment Protection (password) — no app-level secret needed.
# Each tracked SaaS gets its own block of env vars below.
# =============================================================================

# -----------------------------------------------------------------------------
# Google APIs (shared service account for GA4 + GSC)
# -----------------------------------------------------------------------------
# 1. Create a GCP project (or reuse). Enable: "Google Analytics Data API",
#    "Search Console API".
# 2. IAM → Service Accounts → Create. Download JSON key.
# 3. GA4: Admin → Property access → add SA email as Viewer.
# 4. GSC: Settings → Users and permissions → add SA email (Restricted).
# 5. Set the two vars below.
GOOGLE_SERVICE_ACCOUNT_EMAIL=tracker@your-gcp-project.iam.gserviceaccount.com
# Base64-encode the *entire* JSON key and paste here (one line).
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
#   Bash:       base64 -w0 key.json
GOOGLE_SERVICE_ACCOUNT_KEY_B64=

# -----------------------------------------------------------------------------
# Product Hunt (read-only developer token)
#   https://www.producthunt.com/v2/oauth/applications → create app → Developer Token
# -----------------------------------------------------------------------------
PRODUCT_HUNT_TOKEN=

# -----------------------------------------------------------------------------
# Lirefin
# -----------------------------------------------------------------------------
LIREFIN_SUPABASE_URL=https://xxxx.supabase.co
LIREFIN_SUPABASE_SERVICE_KEY=eyJ...
LIREFIN_DODO_API_KEY=
# 'live_mode' (real money) or 'test_mode' (sandbox)
LIREFIN_DODO_ENV=live_mode
LIREFIN_GA4_PROPERTY_ID=

# -----------------------------------------------------------------------------
# Future SaaS template (uncomment & rename when adding):
#   <SLUG>_SUPABASE_URL=
#   <SLUG>_SUPABASE_SERVICE_KEY=
#   <SLUG>_DODO_API_KEY=
#   <SLUG>_DODO_ENV=
#   <SLUG>_GA4_PROPERTY_ID=
# Then add the entry to src/lib/products.ts.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Google Ads (Phase 6 — fill in after developer-token approval)
# -----------------------------------------------------------------------------
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
