# =============================================================================
# saas-tracker — environment variables
# Auth: Vercel Deployment Protection (password) — no app-level secret needed.
# Each tracked SaaS gets its own block of env vars below.
# =============================================================================

# -----------------------------------------------------------------------------
# Google APIs (shared OAuth user-credential for GA4 + GSC)
# -----------------------------------------------------------------------------
# We use OAuth user credentials (not a Service Account) because:
#  - The owner's Gmail is already admin on the GA4 property + GSC site.
#  - Service Accounts need a fresh GCP project, which hits the personal
#    project quota fast.
#
# One-time setup:
#  1. Pick any existing GCP project you own (or the one your Firebase /
#     Lirefin extension OAuth client lives in). Enable on it:
#        - "Google Analytics Data API"
#        - "Search Console API"
#  2. APIs & Services → Credentials → Create credentials →
#     OAuth client ID → "Desktop app". Copy the Client ID + Secret.
#  3. From this repo:
#        node scripts/get-refresh-token.mjs <CLIENT_ID> <CLIENT_SECRET>
#     Sign in with the admin Gmail, grant both scopes. The script
#     prints a refresh token.
#  4. Set all three values in Vercel.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# -----------------------------------------------------------------------------
# Product Hunt (read-only developer token)
#   https://www.producthunt.com/v2/oauth/applications → create app → Developer Token
# -----------------------------------------------------------------------------
PRODUCT_HUNT_TOKEN=

# -----------------------------------------------------------------------------
# Lirefin
# -----------------------------------------------------------------------------
LIREFIN_SUPABASE_URL=https://xxxx.supabase.co
LIREFIN_SUPABASE_SERVICE_KEY=eyJ...
LIREFIN_DODO_API_KEY=
# 'live_mode' (real money) or 'test_mode' (sandbox)
LIREFIN_DODO_ENV=live_mode
LIREFIN_GA4_PROPERTY_ID=
# Day 0 of the 60-day gate window. Set this to the day all distribution
# channels are simultaneously live (Ads + PH + Outrank). Format: YYYY-MM-DD.
# If unset, defaults to today — fine for a fresh dashboard, but the
# Gate-1 metrics will be unfair if Ads aren't running yet.
LIREFIN_TEST_START_DATE=

# -----------------------------------------------------------------------------
# Future SaaS template (uncomment & rename when adding):
#   <SLUG>_SUPABASE_URL=
#   <SLUG>_SUPABASE_SERVICE_KEY=
#   <SLUG>_DODO_API_KEY=
#   <SLUG>_DODO_ENV=
#   <SLUG>_GA4_PROPERTY_ID=
# Then add the entry to src/lib/products.ts.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Google Ads (Phase 6 — fill in after developer-token approval)
# -----------------------------------------------------------------------------
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
